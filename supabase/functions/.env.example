# Edge Function secrets. Copy to supabase/functions/.env (git-ignored) for local serving;
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by the runtime.
# Optional dev fallback for users without their own key (BYOK); leave unset in production.
MISTRAL_API_KEY=
# Defaults to https://api.mistral.ai; override to test against a local stub.
MISTRAL_API_BASE_URL=https://api.mistral.ai
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
