# Copy to supabase/functions/.env for `supabase functions serve`, or set as Edge Function
# secrets with `supabase secrets set --env-file`. Never commit real values.
# Users bring their own Mistral key (stored in Vault). If this is set, it is used as a
# fallback for users without one: development only, leave it unset in production.
MISTRAL_API_KEY=
# Override only to point key verification and model calls at a local stub.
MISTRAL_API_BASE_URL=https://api.mistral.ai

# Injected automatically by the Edge Runtime; only needed when running functions elsewhere.
SUPABASE_URL=http://127.0.0.1:<api-port-from-supabase-status>
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sign in with Apple (supabase/config.toml)
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=com.example.mistralbot
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Voice (Phase 5)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
